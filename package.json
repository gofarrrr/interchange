{
  "name": "interchange-field-guide",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "36 AI transformation stations. Neutral shell, chromatic network. Static, dependency-free review build.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:public": "node scripts/build.mjs --public",
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/validate.mjs",
    "check:links": "node scripts/check-links.mjs",
    "build:astro": "node scripts/astro-build.mjs",
    "search:pagefind": "pagefind --site dist --root-selector '[data-pagefind-body]'",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "astro": "^7.0.0",
    "pagefind": "^1.3.0",
    "typescript": "^5.8.3"
  }
}
